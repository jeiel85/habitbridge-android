    <!-- Onboarding / permissions -->
    <string name="onb_title">Set up HabitBridge</string>
    <string name="onb_intro">HabitBridge pauses you for a few seconds when a target app opens and offers a one-tap micro-swap instead. Everything stays on this device: there is no INTERNET permission at all.</string>
    <string name="onb_required">Required</string>
    <string name="onb_optional">Optional</string>
    <string name="onb_granted">Granted</string>
    <string name="onb_grant">Grant</string>
    <string name="perm_usage_title">Usage access</string>
    <string name="perm_usage_why">Lets HabitBridge notice which app is in front (screen on only). It does not read anything inside apps.</string>
    <string name="perm_overlay_title">Display over other apps</string>
    <string name="perm_overlay_why">Draws the pause screen on top of the target app.</string>
    <string name="perm_notif_title">Notifications</string>
    <string name="perm_notif_why">Android requires a quiet notification while detection runs.</string>
    <string name="perm_a11y_title">Accessibility service (optional)</string>
    <string name="perm_a11y_why">Faster detection and a clean return to home. Not an accessibility tool; nothing is read from the screen.</string>
    <string name="perm_calendar_title">Calendar (optional)</string>
    <string name="perm_calendar_why">Turns the shield to no-bypass during busy calendar events.</string>
    <string name="perm_battery_title">Battery optimisation (recommended)</string>
    <string name="perm_battery_why">Keeps detection alive on phones that kill background apps.</string>
    <string name="onb_backup_note">Auto Backup includes your logs and quick notes so they move with you to a new phone.</string>
