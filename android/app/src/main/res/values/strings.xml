<resources>
    <string name="app_name">HabitBridge</string>
    <string name="app_tagline">Don\'t just block dopamine. Swap it intentionally.</string>
    <string name="accessibility_label">HabitBridge (optional, faster detection)</string>
    <string name="accessibility_description">Optional. HabitBridge is not an accessibility tool: it uses this service only to notice faster when one of the apps you selected opens, and to return you to the home screen after a micro-swap. Nothing is read from the screen and nothing leaves the device. HabitBridge also works without it (with about one second of delay).</string>

